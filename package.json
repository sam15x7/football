{
  "name": "sports-channels-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Backend tools to add/remove sports channels and auto-regenerate index.html (public site has no add form).",
  "scripts": {
    "admin": "node admin/serve.js",
    "token:setup": "node admin/setup-token.js",
    "token:check": "node admin/setup-token.js --check",
    "channel:add": "node admin/add-channel.js",
    "channel:remove": "node admin/remove-channel.js",
    "index:sync": "node admin/sync-index.js"
  }
}
